# CockroachDB connection string (get this from the CockroachDB Cloud console:
# Cluster -> Connect -> Connection string). Must include sslmode=verify-full
# and the path to the cluster's CA cert unless using CockroachDB Serverless
# with the bundled cert, e.g.:
# postgresql://<user>:<password>@<host>:26257/<database>?sslmode=verify-full
DATABASE_URL=

# AWS credentials for Bedrock (Amazon Titan Text Embeddings V2, 1024 dims).
# Use an IAM user/role with bedrock:InvokeModel permission for the Titan
# embeddings model in your chosen region.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed if using temporary/STS credentials
AWS_SESSION_TOKEN=

# Bedrock model id for Titan Text Embeddings (1024-dim output)
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
